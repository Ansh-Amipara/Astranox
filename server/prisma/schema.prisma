generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  username         String   @unique
  email            String   @unique
  passwordHash     String
  role             Role     @default(USER)
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trainerSave TrainerSave?
}

model TrainerSave {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  starterChosenAt DateTime?
  money           Int       @default(3000)

  badges String[] // e.g. ["Boulder Badge", "Cascade Badge"]

  // Location
  continentId String? @db.Uuid
  regionId    String? @db.Uuid
  areaId      String? @db.Uuid
  gameMapId   String? @db.Uuid
  positionX   Int     @default(0)
  positionY   Int     @default(0)
  facing      String  @default("DOWN")

  party        OwnedPokemon[]
  inventory    InventoryItem[]
  battles      BattleSession[]
  defeatedNpcs TrainerDefeatedNpc[]

  explorationProgress ExplorationProgress[]
  questProgress       PlayerQuestProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OwnedPokemon {
  id        String      @id @default(uuid()) @db.Uuid
  trainerId String      @db.Uuid
  trainer   TrainerSave @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  speciesId Int
  species   Species @relation(fields: [speciesId], references: [id])

  nickname String?
  level    Int     @default(5)

  // Location Tracking
  isParty   Boolean @default(false)
  boxNumber Int? // 0 to 31. Null if in party.
  position  Int     @default(0) // 0 to 5 if party, 0 to 29 if box.

  // Basic IVs for now (will be expanded in Phase 5)
  ivHp      Int @default(0)
  ivAttack  Int @default(0)
  ivDefense Int @default(0)
  ivSpAtk   Int @default(0)
  ivSpDef   Int @default(0)
  ivSpeed   Int @default(0)

  // Experience System (Phase 15)
  currentXp Int @default(0)

  // Moves (Phase 18 Refactored)
  moves OwnedPokemonMove[]

  createdAt DateTime @default(now())
}

model OwnedPokemonMove {
  id             Int          @id @default(autoincrement())
  ownedPokemonId String       @db.Uuid
  moveId         Int
  slot           Int          @default(0) // 0 to 3 for the four move slots

  ownedPokemon OwnedPokemon @relation(fields: [ownedPokemonId], references: [id], onDelete: Cascade)
  move         Move         @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@unique([ownedPokemonId, slot])
}

model Type {
  id              Int    @id
  name            String @unique
  damageRelations Json

  moves        Move[]
  speciesType1 Species[] @relation("SpeciesType1")
  speciesType2 Species[] @relation("SpeciesType2")
}

model Item {
  id          String  @id
  name        String  @unique
  cost        Int
  description String
  spriteUrl   String?

  inventory InventoryItem[]
}

model InventoryItem {
  id        String      @id @default(uuid()) @db.Uuid
  trainerId String      @db.Uuid
  trainer   TrainerSave @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  quantity Int @default(0)

  @@unique([trainerId, itemId])
}

model Move {
  id          Int    @id
  name        String @unique
  typeId      Int
  type        Type   @relation(fields: [typeId], references: [id])
  power       Int?
  accuracy    Int?
  priority    Int
  damageClass String

  ailment       String?
  ailmentChance Int?
  flinchChance  Int?
  statChanges   Json?

  learnsets        Learnset[]
  ownedPokemonMove OwnedPokemonMove[]
}

model Species {
  id        Int    @id
  name      String @unique
  spriteUrl String

  hp      Int
  attack  Int
  defense Int
  spAtk   Int
  spDef   Int
  speed   Int

  catchRate Int @default(255)
  baseExp   Int @default(100)

  type1Id Int
  type1   Type  @relation("SpeciesType1", fields: [type1Id], references: [id])
  type2Id Int?
  type2   Type? @relation("SpeciesType2", fields: [type2Id], references: [id])

  owned        OwnedPokemon[]
  spawnEntries SpawnEntry[]
  learnsets    Learnset[]
}

model Learnset {
  id         Int @id @default(autoincrement())

  speciesId  Int
  moveId     Int

  level      Int
  learnOrder Int

  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  move    Move    @relation(fields: [moveId], references: [id], onDelete: Cascade)

  @@unique([speciesId, moveId, level])
}

// ----------------------------------------------------------------------
// WORLD HIERARCHY
// ----------------------------------------------------------------------

model World {
  id          String      @id @default(uuid()) @db.Uuid
  name        String      @unique
  description String?
  continents  Continent[]
}

model Continent {
  id          String   @id @default(uuid()) @db.Uuid
  worldId     String   @db.Uuid
  world       World    @relation(fields: [worldId], references: [id], onDelete: Cascade)
  name        String
  description String?
  regions     Region[]
}

model Region {
  id          String   @id @default(uuid()) @db.Uuid
  continentId String   @db.Uuid
  continent   Continent @relation(fields: [continentId], references: [id], onDelete: Cascade)
  name        String
  description String?
  imageUrl    String?

  areas       Area[]
}

enum AreaType {
  CITY
  TOWN
  ROUTE
  WILDERNESS
  DUNGEON
  CAVE
  BUILDING
}

model Area {
  id          String   @id @default(uuid()) @db.Uuid
  regionId    String   @db.Uuid
  region      Region   @relation(fields: [regionId], references: [id], onDelete: Cascade)
  name        String
  description String?
  areaType    AreaType @default(WILDERNESS)

  gameMaps GameMap[]
}

model GameMap {
  id     String @id @default(uuid()) @db.Uuid
  areaId String @db.Uuid
  area   Area   @relation(fields: [areaId], references: [id], onDelete: Cascade)
  name   String
  theme  String // e.g. Grassland, Forest, Volcano

  musicId String?     @db.Uuid
  music   MusicTrack? @relation(fields: [musicId], references: [id])

  difficulty  Int     @default(1)
  mapImage    String?
  npcCount    Int     @default(0)
  hiddenItems Int     @default(0)
  secretArea  Boolean @default(false)
  worldX      Int     @default(0)
  worldY      Int     @default(0)

  weatherProfileId String?         @db.Uuid
  weatherProfile   WeatherProfile? @relation(fields: [weatherProfileId], references: [id])

  seasonProfileId String?        @db.Uuid
  seasonProfile   SeasonProfile? @relation(fields: [seasonProfileId], references: [id])

  spawnGroups SpawnGroup[]
  npcs        Npc[]
  npcTrainers NpcTrainer[]

  connectionsOut WorldConnection[] @relation("SourceMap")
  connectionsIn  WorldConnection[] @relation("TargetMap")

  explorationProgress ExplorationProgress[]
}

model MusicTrack {
  id       String    @id @default(uuid()) @db.Uuid
  name     String
  fileUrl  String
  gameMaps GameMap[]
}

// ----------------------------------------------------------------------
// CONNECTIONS & UNLOCKS
// ----------------------------------------------------------------------

enum ConnectionType {
  ROAD
  CAVE
  WARP
  PORTAL
  STAIRS
  LADDER
  DOOR
  WATER
  FLY
  TELEPORT
}

model WorldConnection {
  id          String  @id @default(uuid()) @db.Uuid
  sourceMapId String  @db.Uuid
  sourceMap   GameMap @relation("SourceMap", fields: [sourceMapId], references: [id], onDelete: Cascade)
  targetMapId String  @db.Uuid
  targetMap   GameMap @relation("TargetMap", fields: [targetMapId], references: [id], onDelete: Cascade)

  connectionType       ConnectionType
  travelCost           Int            @default(0)
  travelAnimation      String?
  pathData             Json?          // Stores curved paths/waypoints
  requiresConfirmation Boolean        @default(false)

  unlockRequirements UnlockRequirement[]
}

enum RequirementType {
  LEVEL
  BADGE
  QUEST
  NPC
  ITEM
  EVENT
  POKEMON
  TIME
  SEASON
}

model UnlockRequirement {
  id                String           @id @default(uuid()) @db.Uuid
  worldConnectionId String?          @db.Uuid
  worldConnection   WorldConnection? @relation(fields: [worldConnectionId], references: [id], onDelete: Cascade)
  requirementType   RequirementType
  value             String
}

// ----------------------------------------------------------------------
// PROFILES & EVENTS
// ----------------------------------------------------------------------

model WeatherProfile {
  id       String    @id @default(uuid()) @db.Uuid
  name     String
  states   Json // e.g. { "NORMAL": 70, "RAIN": 20, "FOG": 10 }
  gameMaps GameMap[]
}

model SeasonProfile {
  id       String    @id @default(uuid()) @db.Uuid
  name     String
  states   Json // e.g. { "SPRING": 25, "SUMMER": 25 }
  gameMaps GameMap[]
}

model WorldEvent {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  isActive  Boolean   @default(false)
  startTime DateTime?
  endTime   DateTime?
}

// ----------------------------------------------------------------------
// SPAWN SYSTEM
// ----------------------------------------------------------------------

model SpawnGroup {
  id        String       @id @default(uuid()) @db.Uuid
  gameMapId String       @db.Uuid
  gameMap   GameMap      @relation(fields: [gameMapId], references: [id], onDelete: Cascade)
  name      String // e.g. "Tall Grass", "Surfing"
  entries   SpawnEntry[]
}

enum SpawnCondition {
  MORNING
  DAY
  EVENING
  NIGHT
  RAIN
  SNOW
  SURF
  FISHING
  ROCK_SMASH
  HEADBUTT
  HONEY_TREE
  RADAR
  SPECIAL_EVENT
}

model SpawnEntry {
  id           String           @id @default(uuid()) @db.Uuid
  spawnGroupId String           @db.Uuid
  spawnGroup   SpawnGroup       @relation(fields: [spawnGroupId], references: [id], onDelete: Cascade)
  speciesId    Int
  species      Species          @relation(fields: [speciesId], references: [id])
  minLevel     Int
  maxLevel     Int
  spawnRate    Float
  conditions   SpawnCondition[]
}

// ----------------------------------------------------------------------
// QUESTS & PROGRESS
// ----------------------------------------------------------------------

model Quest {
  id          String                @id @default(uuid()) @db.Uuid
  name        String
  description String
  objectives  QuestObjective[]
  progress    PlayerQuestProgress[]
}

model QuestObjective {
  id          String @id @default(uuid()) @db.Uuid
  questId     String @db.Uuid
  quest       Quest  @relation(fields: [questId], references: [id], onDelete: Cascade)
  description String
  targetValue Int    @default(1)
}

enum QuestStatus {
  ACTIVE
  COMPLETED
  FAILED
}

model PlayerQuestProgress {
  id           String      @id @default(uuid()) @db.Uuid
  trainerId    String      @db.Uuid
  trainer      TrainerSave @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  questId      String      @db.Uuid
  quest        Quest       @relation(fields: [questId], references: [id], onDelete: Cascade)
  status       QuestStatus @default(ACTIVE)
  currentValue Int         @default(0)
}

model ExplorationProgress {
  id        String      @id @default(uuid()) @db.Uuid
  trainerId String      @db.Uuid
  trainer   TrainerSave @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  gameMapId String      @db.Uuid
  gameMap   GameMap     @relation(fields: [gameMapId], references: [id], onDelete: Cascade)

  mapsCleared          Int   @default(0)
  bossesDefeated       Int   @default(0)
  npcsDefeated         Int   @default(0)
  itemsFound           Int   @default(0)
  secretsFound         Int   @default(0)
  rarePokemonSeen      Int   @default(0)
  rarePokemonCaught    Int   @default(0)
  completionPercentage Float @default(0)
}

// ----------------------------------------------------------------------
// NPCS & TRAINERS
// ----------------------------------------------------------------------

model Npc {
  id        String  @id @default(uuid()) @db.Uuid
  gameMapId String  @db.Uuid
  gameMap   GameMap @relation(fields: [gameMapId], references: [id], onDelete: Cascade)
  name      String
  spriteUrl String
  dialogue  Json // array or object of dialogue lines
}

enum BattleStatus {
  ACTIVE
  WAITING_SWITCH
  WON
  LOST
  FLED
  CAUGHT
}

enum BattleType {
  WILD
  NPC
}

model BattleSession {
  id        String      @id @default(uuid()) @db.Uuid
  trainerId String      @db.Uuid
  trainer   TrainerSave @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  status     BattleStatus @default(ACTIVE)
  battleType BattleType   @default(WILD)
  turnNumber Int          @default(1)

  playerActivePokemonId String  @db.Uuid
  npcTrainerId          String? @db.Uuid

  opponentPokemonData Json  @default("{}") // Replaces wildPokemonData
  opponentPartyData   Json? // Array of all NPC party members

  playerPokemonData Json
  playerPartyData   Json? // Array of all 6 party members' active states mid-battle

  log Json? // Array of TurnEvent

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TrainerType {
  NORMAL
  GYM
  ELITE
  CHAMPION
  RIVAL
  BOSS
  LEGENDARY
}

model NpcTrainer {
  id           String      @id @default(uuid()) @db.Uuid
  name         String
  spriteUrl    String
  trainerClass String
  rewardMoney  Int         @default(0)
  badgeName    String?
  trainerType  TrainerType @default(NORMAL)

  gameMapId String?  @db.Uuid
  gameMap   GameMap? @relation(fields: [gameMapId], references: [id], onDelete: Cascade)

  party      NpcTrainerPokemon[]
  defeatedBy TrainerDefeatedNpc[]
}

model NpcTrainerPokemon {
  id           String     @id @default(uuid()) @db.Uuid
  npcTrainerId String     @db.Uuid
  npcTrainer   NpcTrainer @relation(fields: [npcTrainerId], references: [id], onDelete: Cascade)

  speciesId Int
  level     Int @default(5)
  position  Int @default(0)

  ivHp      Int @default(0)
  ivAttack  Int @default(0)
  ivDefense Int @default(0)
  ivSpAtk   Int @default(0)
  ivSpDef   Int @default(0)
  ivSpeed   Int @default(0)
}

model TrainerDefeatedNpc {
  id        String      @id @default(uuid()) @db.Uuid
  trainerId String      @db.Uuid
  trainer   TrainerSave @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  npcTrainerId String     @db.Uuid
  npcTrainer   NpcTrainer @relation(fields: [npcTrainerId], references: [id], onDelete: Cascade)

  defeatedAt DateTime @default(now())

  @@unique([trainerId, npcTrainerId])
}

model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  adminId      String   @db.Uuid
  action       String
  entityType   String
  entityId     String?
  beforeValues Json?
  afterValues  Json?
  ipAddress    String?
  createdAt    DateTime @default(now())
}
