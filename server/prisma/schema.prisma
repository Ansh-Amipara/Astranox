generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id               String   @id @default(uuid()) @db.Uuid
  username         String   @unique
  email            String   @unique
  passwordHash     String
  role             Role     @default(USER)
  refreshTokenHash String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  trainerSave      TrainerSave?
}

model TrainerSave {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  starterChosenAt DateTime?
  money           Int      @default(3000)
  
  party           OwnedPokemon[]
  battles         BattleSession[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model OwnedPokemon {
  id              String   @id @default(uuid()) @db.Uuid
  trainerId       String   @db.Uuid
  trainer         TrainerSave @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  
  speciesId       Int
  species         Species  @relation(fields: [speciesId], references: [id])
  
  nickname        String?
  level           Int      @default(5)
  
  // Location Tracking
  isParty         Boolean  @default(false)
  boxNumber       Int?     // 0 to 31. Null if in party.
  position        Int      @default(0) // 0 to 5 if party, 0 to 29 if box.
  
  // Basic IVs for now (will be expanded in Phase 5)
  ivHp            Int      @default(0)
  ivAttack        Int      @default(0)
  ivDefense       Int      @default(0)
  ivSpAtk         Int      @default(0)
  ivSpDef         Int      @default(0)
  ivSpeed         Int      @default(0)

  createdAt       DateTime @default(now())
}

model Type {
  id              Int       @id
  name            String    @unique
  damageRelations Json

  moves           Move[]
  speciesType1    Species[] @relation("SpeciesType1")
  speciesType2    Species[] @relation("SpeciesType2")
}

model Move {
  id           Int      @id
  name         String   @unique
  typeId       Int
  type         Type     @relation(fields: [typeId], references: [id])
  power        Int?
  accuracy     Int?
  priority     Int
  damageClass  String

  ailment        String?
  ailmentChance  Int?
  flinchChance   Int?
  statChanges    Json?
}

model Species {
  id          Int      @id
  name        String   @unique
  spriteUrl   String
  
  hp          Int
  attack      Int
  defense     Int
  spAtk       Int
  spDef       Int
  speed       Int

  type1Id     Int
  type1       Type     @relation("SpeciesType1", fields: [type1Id], references: [id])
  type2Id     Int?
  type2       Type?    @relation("SpeciesType2", fields: [type2Id], references: [id])

  owned       OwnedPokemon[]
  encounters  ZoneEncounter[]
}

model Habitat {
  id    Int     @id @default(autoincrement())
  name  String  @unique
  zones Zone[]
}

model Zone {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  habitatId   Int
  habitat     Habitat @relation(fields: [habitatId], references: [id], onDelete: Cascade)
  minLevel    Int
  maxLevel    Int
  
  encounters  ZoneEncounter[]
}

model ZoneEncounter {
  id          Int     @id @default(autoincrement())
  zoneId      Int
  zone        Zone    @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  speciesId   Int
  species     Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)
  encounterRate Float
}

enum BattleStatus {
  ACTIVE
  WON
  LOST
  FLED
}

model BattleSession {
  id                    String       @id @default(uuid()) @db.Uuid
  trainerId             String       @db.Uuid
  trainer               TrainerSave  @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  
  status                BattleStatus @default(ACTIVE)
  turnNumber            Int          @default(1)

  playerActivePokemonId String       @db.Uuid
  wildPokemonData       Json
  playerPokemonData     Json

  log                   Json?        // Array of TurnEvent

  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
}
