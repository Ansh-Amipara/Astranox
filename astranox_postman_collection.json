              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Trainers",
      "item": [
        {
          "name": "Get My Save",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/trainers/me",
              "host": ["{{baseUrl}}"],
              "path": ["trainers", "me"]
            }
          }
        },
        {
          "name": "Pick Starter",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{accessToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"speciesId\": 147\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/trainers/starter",
              "host": ["{{baseUrl}}"],
              "path": ["trainers", "starter"]
            }
          }
        },
        {
          "name": "Get Box",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{accessToken}}"}],
            "url": {
              "raw": "{{baseUrl}}/trainers/box/0",
              "host": ["{{baseUrl}}"],
              "path": ["trainers", "box", "0"]
            }
          }
        },
        {
          "name": "Swap Slots",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{accessToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"from\": {\n    \"isParty\": true,\n    \"boxNumber\": null,\n    \"position\": 0\n  },\n  \"to\": {\n    \"isParty\": false,\n    \"boxNumber\": 0,\n    \"position\": 0\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/trainers/swap",
              "host": ["{{baseUrl}}"],
              "path": ["trainers", "swap"]
            }
          }
        }
      ]
    },
    {
      "name": "Battles",
      "item": [
        {
          "name": "Engage Wild",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Authorization", "value": "Bearer {{accessToken}}"},
              {"key": "Content-Type", "value": "application/json"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"zoneId\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/battles/engage",
              "host": ["{{baseUrl}}"],
              "path": ["battles", "engage"]
