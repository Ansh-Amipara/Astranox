generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

enum TrainerRank {
  F
  E
  D
  C
  B
  A
  S_MINUS
  S
  S_PLUS
  SS_MINUS
  SS
  SS_PLUS
  SSS_MINUS
  SSS
  SSS_PLUS
  EX
}

enum PokemonPotential {
  F
  E
  D
  C
  B
  A
  S_MINUS
  S
  S_PLUS
  SS_MINUS
  SS
  SS_PLUS
  SSS_MINUS
  SSS
  SSS_PLUS
  EX
}

model User {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  username         String   @unique
  email            String   @unique
  passwordHash     String
  role             Role     @default(USER)
  refreshTokenHash String?
  isBanned         Boolean  @default(false)
  banReason        String?
  bannedUntil      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  trainerSave TrainerSave?
  refreshTokens RefreshToken[]
}

model RefreshToken {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @db.ObjectId
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  userAgent  String?
  ip         String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, expiresAt])
}

model TrainerSave {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  starterChosenAt DateTime?
  astralCoins     Int       @default(3000)
  infinityCoins   Int       @default(0)
  storedXp        Int       @default(0)
  rank            TrainerRank @default(F)
  dataVersion     Int       @default(1)

  party        OwnedPokemon[]
  inventory    InventoryItem[]
  battles      BattleSession[]
  unlockedMoves PlayerUnlockedMoves[] @relation("UnlockedMoves")

  unlockedForms Int[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tradesInitiated TradeRequest[] @relation("TradesInitiated")
  tradesReceived  TradeRequest[] @relation("TradesReceived")

  // Marketplace
  tradeListings   TradeListing[] @relation("ListingsCreated")
  tradeOffers     TradeOffer[]   @relation("OffersCreated")

  infinityTowerState InfinityTowerState?
  riftState          RiftDungeonState?
  eventProgress      PlayerEventProgress[]


  encounterHistory    EncounterHistory[]
}

model OwnedPokemon {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  trainerId String      @db.ObjectId
  trainer   TrainerSave @relation(fields: [trainerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  speciesId Int
  species   Species @relation(fields: [speciesId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  nickname String?
  level    Int     @default(5)
  potential PokemonPotential @default(F)

  // Location Tracking
  isParty   Boolean @default(false)
  boxNumber Int? // 0 to 31. Null if in party.
  position  Int     @default(0) // 0 to 5 if party, 0 to 29 if box.
  
  isBound   Boolean @default(false)

  // IVs
  ivHp      Int @default(0)
  ivAttack  Int @default(0)
  ivDefense Int @default(0)
  ivSpAtk   Int @default(0)
  ivSpDef   Int @default(0)
  ivSpeed   Int @default(0)

  // Experience System (Phase 15)
  currentXp Int @default(0)

  // Moves (Phase 18 Refactored)
  equippedMoves PokemonEquippedMoves[] @relation("EquippedMoves")

  // Trading
  isForTrade Boolean @default(false)
  isEscrowed Boolean @default(false)
  offeredInTrades   TradeRequest[] @relation("OfferedInTrades")
  requestedInTrades TradeRequest[] @relation("RequestedInTrades")

  tradeListings TradeListing[] @relation("ListingPokemon")
  escrowOffers  EscrowOfferPokemon[] @relation("OfferedPokemon")

  dataVersion Int      @default(1)
  createdAt   DateTime @default(now())

  @@index([trainerId, isParty])
  @@index([trainerId, isEscrowed])
}

model PokemonEquippedMoves {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  ownedPokemonId String       @db.ObjectId
  moveId         Int
  slot           Int          @default(0) // 0 to 3 for the four move slots

  ownedPokemon OwnedPokemon @relation("EquippedMoves", fields: [ownedPokemonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  move         Move         @relation(fields: [moveId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([ownedPokemonId, slot])
}

model PlayerUnlockedMoves {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  trainerId String @db.ObjectId
  moveId    Int

  purchasedAt DateTime @default(now())

  trainer TrainerSave @relation("UnlockedMoves", fields: [trainerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  move    Move        @relation(fields: [moveId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([trainerId, moveId])
}

model AstralMoveShop {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  moveId Int @unique
  price  Int

  move Move @relation(fields: [moveId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model Type {
  id Int @id @map("_id")
  name            String @unique
  damageRelations Json

  moves        Move[]
  speciesType1 Species[] @relation("SpeciesType1")
  speciesType2 Species[] @relation("SpeciesType2")
}

model Item {
  id String @id @map("_id")
  name        String  @unique
  cost        Int
  description String
  spriteUrl   String?
  category    String  @default("misc")

  inventory InventoryItem[]
}

model InventoryItem {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  trainerId String      @db.ObjectId
  trainer   TrainerSave @relation(fields: [trainerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  quantity    Int @default(0)
  dataVersion Int @default(1)

  @@unique([trainerId, itemId])
}

model Move {
  id Int @id @map("_id")
  name        String @unique
  typeId      Int
  type        Type   @relation(fields: [typeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  power       Int?
  damageClass String

  learnsets             PokemonLearnset[]
  equippedMoves         PokemonEquippedMoves[]
  shopEntries           AstralMoveShop[]
  playerUnlocks         PlayerUnlockedMoves[]
}

model Species {
  id Int @id @map("_id")
  name      String @unique
  spriteUrl String

  hp      Int
  attack  Int
  defense Int
  spAtk   Int
  spDef   Int
  speed   Int

  catchRate Int @default(255)
  baseExp   Int @default(100)
  rank      String @default("F")

  // Forms support
  formName      String?
  isMega        Boolean @default(false)
  isGmax        Boolean @default(false)
  baseSpeciesId Int?
  pokedexNumber Int?

  type1Id Int
  type1   Type  @relation("SpeciesType1", fields: [type1Id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type2Id Int?
  type2   Type? @relation("SpeciesType2", fields: [type2Id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  evolutionLevel Int?
  evolvesFromId  Int?
  evolveByBattle Boolean @default(false)
  megaEvolvesToIds Int[]
  gmaxEvolvesToIds Int[]
  evolvesFrom    Species?  @relation("Evolution", fields: [evolvesFromId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  evolvesTo      Species[] @relation("Evolution")

  owned        OwnedPokemon[]
  learnsets    PokemonLearnset[]
}

model PokemonLearnset {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  speciesId  Int
  moveId     Int

  unlockLevel Int

  species Species @relation(fields: [speciesId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  move    Move    @relation(fields: [moveId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([speciesId, moveId, unlockLevel])
}

// ----------------------------------------------------------------------
// BATTLES & NPCS
// ----------------------------------------------------------------------

enum BattleStatus {
  ACTIVE
  WAITING_SWITCH
  WAITING_MOVE_LEARN
  WON
  LOST
  FLED
  CAUGHT
}

enum BattleType {
  WILD
  NPC
  TOWER
  RIFT
  EVOLVE
}

model BattleSession {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  trainerId String      @db.ObjectId
  trainer   TrainerSave @relation(fields: [trainerId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  status     BattleStatus @default(ACTIVE)
  battleType BattleType   @default(WILD)
  turnNumber Int          @default(1)

  playerActivePokemonId String  @db.ObjectId

  opponentPokemonData Json  @default("{}") // Replaces wildPokemonData
  opponentPartyData   Json? // Array of all NPC party members

  playerPokemonData Json
  playerPartyData   Json? // Array of all 6 party members' active states mid-battle

  log Json? // Array of TurnEvent

  balanceVersion Int?     @default(1)
  dataVersion Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([trainerId, status])
  @@index([status, battleType])
}

model AuditLog {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId      String?  @db.ObjectId
  actorType    String   @default("user") // "user" | "system" | "admin"
  action       String
  entityType   String
  entityId     String?
  reason       String?
  before       Json?
  after        Json?
  meta         Json?
  requestId    String?
  ip           String?
  createdAt    DateTime @default(now())

  // Backward compatibility fields for existing admin queries
  adminId      String?  @db.ObjectId
  beforeValues Json?
  afterValues  Json?
  ipAddress    String?

  @@index([actorId, createdAt])
  @@index([adminId, createdAt])
  @@index([entityType, entityId])
  @@index([requestId])
}

model IdempotencyKey {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  key            String
  userId         String    @db.ObjectId
  route          String
  requestHash    String
  status         String    @default("processing") // "processing" | "completed"
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime  @default(now())

  @@unique([userId, key])
  @@index([createdAt])
}

model MigrationRun {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  batch     Int
  appliedAt DateTime @default(now())
}

model BalanceConfig {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  section     String    // 'battle' | 'catch' | 'exploration' | 'progression' | 'economy' | 'limits' | 'arena' | 'rank' | 'tower' | 'rift'
  version     Int       @default(1)
  values      Json      // ONLY the overridden values
  status      String    @default("draft") // 'draft' | 'active' | 'archived'
  createdBy   String?   @db.ObjectId
  publishedBy String?   @db.ObjectId
  publishedAt DateTime?
  reason      String?
  dataVersion Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([section, version])
  @@index([section, status])
}

model ShopItem {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  key                String    @unique
  name               String
  category           String
  description        String
  currency           String    @default("astralCoins")
  price              Int
  salePrice          Int?
  saleStartsAt       DateTime?
  saleEndsAt         DateTime?
  enabled            Boolean   @default(true)
  isArchived         Boolean   @default(false)
  spriteUrl          String?
  effectType         String?
  effectConfig       Json?
  minLevel           Int?
  dailyLimitPerUser  Int?
  totalStock         Int?
  stockRemaining     Int?
  sortOrder          Int       @default(0)
  dataVersion        Int       @default(1)
  updatedBy          String?   @db.ObjectId
  updatedAt          DateTime  @updatedAt
  createdAt          DateTime  @default(now())

  @@index([category, sortOrder])
  @@index([isArchived, enabled])
}

model ShopPriceHistory {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  itemKey      String
  oldPrice     Int
  newPrice     Int
  oldSalePrice Int?
  newSalePrice Int?
  changedBy    String    @db.ObjectId
  reason       String
  requestId    String?
  createdAt    DateTime  @default(now())

  @@index([itemKey, createdAt])
}

model UserDailyPurchase {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  itemKey   String
  date      String   // YYYY-MM-DD
  count     Int      @default(0)

  @@unique([userId, itemKey, date])
}

model FeatureFlag {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  key            String    @unique
  name           String?
  description    String?
  enabled        Boolean   @default(true)
  rolloutPercent Int?
  allowUserIds   String[]  @default([])
  updatedBy      String?   @db.ObjectId
  updatedAt      DateTime? @updatedAt
  createdAt      DateTime? @default(now())
}

model Announcement {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  message     String
  type        String    @default("info")
  active      Boolean   @default(true)
  createdBy   String    @db.ObjectId
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ----------------------------------------------------------------------
// TRADING (Phase 22)
// ----------------------------------------------------------------------

enum TradeStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

model TradeRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId
  
  initiatorId        String @db.ObjectId
  receiverId         String @db.ObjectId

  offeredPokemonId   String @db.ObjectId
  requestedPokemonId String @db.ObjectId

  status             TradeStatus @default(PENDING)

  initiator          TrainerSave @relation("TradesInitiated", fields: [initiatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receiver           TrainerSave @relation("TradesReceived", fields: [receiverId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  offeredPokemon     OwnedPokemon @relation("OfferedInTrades", fields: [offeredPokemonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedPokemon   OwnedPokemon @relation("RequestedInTrades", fields: [requestedPokemonId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// ----------------------------------------------------------------------
// INFINITY TOWER
// ----------------------------------------------------------------------

model InfinityTowerState {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  trainerId           String   @unique @db.ObjectId
  trainer             TrainerSave @relation(fields: [trainerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentFloor        Int      @default(1)
  highestFloor        Int      @default(0)
  infinityCoins       Int      @default(0)
  currentEncounterId  String?  @db.ObjectId
  currentRunStartedAt DateTime?
  floorsCompleted     Int      @default(0)
  totalVictories      Int      @default(0)
  totalDefeats        Int      @default(0)
  balanceVersion      Int?     @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum EncounterStatus {
  ACTIVE
  CLEARED
  FAILED
}

model InfinityTowerEncounter {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  towerStateId String @db.ObjectId
  floor        Int
  seed         String
  enemyTeam    Json
  reward       Json
  status       EncounterStatus
  createdAt    DateTime @default(now())
}

model InfinityCoinTransaction {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  trainerId String @db.ObjectId
  amount    Int
  reason    String
  createdAt DateTime @default(now())
}

// ----------------------------------------------------------------------
// RIFT DUNGEON
// ----------------------------------------------------------------------

enum RiftDifficulty {
  NORMAL
  HARD
  NIGHTMARE
  ABYSS
}

model RiftDungeonState {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  trainerId           String   @unique @db.ObjectId
  trainer             TrainerSave @relation(fields: [trainerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  
  rank                TrainerRank @default(F)
  difficulty          RiftDifficulty @default(NORMAL)
  
  currentFloor        Int      @default(1)
  highestFloor        Int      @default(0)
  
  currentEncounterId  String?  @db.ObjectId
  currentRunStartedAt DateTime?
  
  totalRiftsCleared   Int      @default(0)
  balanceVersion      Int?     @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model RiftEncounter {
  id           String @id @default(auto()) @map("_id") @db.ObjectId
  riftStateId  String @db.ObjectId
  floor        Int
  enemyTeam    Json
  reward       Json
  status       EncounterStatus
  createdAt    DateTime @default(now())
}

// ----------------------------------------------------------------------
// TRADE EXCHANGE MARKETPLACE
// ----------------------------------------------------------------------

enum TradeListingStatus {
  OPEN
  COMPLETED
  CANCELLED
  EXPIRED
}

enum TradeOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  RETURNED
  CANCELLED
}

model TradeListing {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  sellerId    String   @db.ObjectId
  pokemonId   String   @db.ObjectId
  description String?
  status      TradeListingStatus @default(OPEN)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  seller      TrainerSave  @relation("ListingsCreated", fields: [sellerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  pokemon     OwnedPokemon @relation("ListingPokemon", fields: [pokemonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  offers      TradeOffer[]

  @@index([status, expiresAt])
  @@index([sellerId, status])
}

model TradeOffer {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  listingId   String   @db.ObjectId
  bidderId    String   @db.ObjectId
  status      TradeOfferStatus @default(PENDING)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  listing     TradeListing @relation(fields: [listingId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bidder      TrainerSave  @relation("OffersCreated", fields: [bidderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  offeredPokemon EscrowOfferPokemon[]

  @@index([listingId, status])
  @@index([bidderId, status])
}

model EscrowOfferPokemon {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  offerId     String   @db.ObjectId
  pokemonId   String   @db.ObjectId

  offer       TradeOffer   @relation(fields: [offerId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pokemon     OwnedPokemon @relation("OfferedPokemon", fields: [pokemonId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// ----------------------------------------------------------------------
// EVENT CHALLENGES
// ----------------------------------------------------------------------

enum EventTaskType {
  CLEAR_RIFT
  CLEAR_TOWER
  CAPTURE_POKEMON
  DEFEAT_WILD_POKEMON
}

model EventChallenge {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(false)
  isArchived  Boolean  @default(false)

  taskType    EventTaskType
  taskConfig  Json     // e.g., { requiredCount: 5, pokemonType: "Fire" }
  rewardConfig Json    // e.g., { speciesId: 6, form: "Mega", potential: "EX", level: 5 }
  pokemonPool Json?    // array of { speciesId: number, name: string, minLevel: number, maxLevel: number, weight: number }

  playerProgress PlayerEventProgress[]

  dataVersion Int      @default(1)
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, isArchived])
}

model PlayerEventProgress {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  trainerId       String   @db.ObjectId
  eventChallengeId String  @db.ObjectId
  
  progress        Int      @default(0)
  isClaimed       Boolean  @default(false)

  trainer         TrainerSave    @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  eventChallenge  EventChallenge @relation(fields: [eventChallengeId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([trainerId, eventChallengeId])
}

model EncounterHistory {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  trainerId String   @db.ObjectId
  trainer   TrainerSave @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  mapId     String
  speciesId Int
  level     Int
  outcome   String   // "WON" | "CAPTURED" | "DEFEATED" | "FLED"
  battleId  String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([trainerId, createdAt])
}

// ----------------------------------------------------------------------
// ARENA & RANK UP CONTENT MANAGEMENT
// ----------------------------------------------------------------------

model ArenaTrainer {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  key             String   @unique
  name            String
  targetRank      String   // e.g. "F", "E", "D", "C", "B", "A", "S_MINUS", "S", "S_PLUS"
  level           Int
  team            String[] // array of species slugs/names
  coins           Int
  xp              Int
  theme           String
  ratingDelta     Int      @default(25)
  cooldownMinutes Int      @default(0)
  enabled         Boolean  @default(true)
  isArchived      Boolean  @default(false)
  sortOrder       Int      @default(0)
  dataVersion     Int      @default(1)
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([targetRank, isArchived, enabled])
}

model RankDefinition {
  id              String      @id @default(auto()) @map("_id") @db.ObjectId
  rank            TrainerRank @unique
  name            String
  minLevel        Int
  maxLevel        Int
  requiredWins    Int         @default(0)
  examinerName    String
  examinerLevel   Int
  examinerAce     String
  examinerTeam    String[]
  rewardCoins     Int
  rewardXp        Int
  rewardItems     String[]    @default([])
  enabled         Boolean     @default(true)
  sortOrder       Int         @default(0)
  dataVersion     Int         @default(1)
  updatedBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

// ----------------------------------------------------------------------
// DUNGEON FLOOR RULES (INFINITY TOWER & VOID RIFTS)
// ----------------------------------------------------------------------

enum DungeonType {
  INFINITY_TOWER
  VOID_RIFT
}

model DungeonFloorRule {
  id                  String         @id @default(auto()) @map("_id") @db.ObjectId
  dungeonType         DungeonType
  floorNumber         Int
  difficulty          RiftDifficulty?
  title               String?
  enemyPool           Json           // array of { speciesId: number, name?: string, level?: number, weight?: number } or static team
  scalingFactor       Float          @default(1.0)
  rewardCoins         Int            @default(0)
  rewardInfinityCoins Int            @default(0)
  rewardXp            Int            @default(0)
  rewardItems         Json?          // array of { itemKey: string, quantity: number, chance?: number }
  ruleModifiers       Json?          // e.g. { weather?: string, banTypes?: string[], hpMultiplier?: number }
  isBossFloor         Boolean        @default(false)
  enabled             Boolean        @default(true)
  isArchived          Boolean        @default(false)
  sortOrder           Int            @default(0)
  dataVersion         Int            @default(1)
  updatedBy           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([dungeonType, floorNumber, difficulty])
  @@index([dungeonType, isArchived, enabled])
}

// ----------------------------------------------------------------------
// WILDERNESS REALMS
// ----------------------------------------------------------------------

model Realm {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  realmId       String   @unique
  name          String
  description   String
  themeKey      String
  types         String[]
  spawnLevelMin Int      @default(5)
  spawnLevelMax Int      @default(35)
  spawns        Json     // Array of RealmSpawnEntry: { speciesId, speciesName, types, rank, weight, minLevel, maxLevel, isApex }
  enabled       Boolean  @default(true)
  sortOrder     Int      @default(0)
  dataVersion   Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([realmId, enabled])
  @@index([sortOrder])
}


